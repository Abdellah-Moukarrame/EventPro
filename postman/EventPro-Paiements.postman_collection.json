{
  "info": {
    "name": "EventPro - Paiements",
    "description": "Utiliser les identifiants de la fixture reservation-demo.sql. Le montant est récupéré depuis la réservation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "categorieId",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "montant",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Créer une réservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\"clientId\": {{clientId}}, \"lignes\": [{\"categorieBilletEvenementId\": {{categorieId}}, \"quantite\": 1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const r = pm.response.json(); pm.collectionVariables.set(\"reservationId\", r.id); pm.collectionVariables.set(\"montant\", r.montantTotal); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Refuser montant incorrect",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/paiements/reservation/{{reservationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"montant\": 99.99}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Payer la réservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/paiements/reservation/{{reservationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"montant\": {{montant}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Paiement réussi\", () => pm.expect(pm.response.json().statut).to.eql(\"SUCCESS\"));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"paymentId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Répéter exactement le paiement",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/paiements/reservation/{{reservationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"montant\": {{montant}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Même paiement\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"paymentId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Montant différent après paiement",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/paiements/reservation/{{reservationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"montant\": 99.99}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Consulter paiement",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/paiements/{{paymentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Consulter par réservation",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/paiements/reservation/{{reservationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Vérifier CONFIRMED",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reservations/{{reservationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Réservation confirmée\", () => pm.expect(pm.response.json().statut).to.eql(\"CONFIRMED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Validation body vide",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/paiements/reservation/{{reservationId}}",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
