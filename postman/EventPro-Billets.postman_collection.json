{
  "info": {
    "name": "EventPro - Billets",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "categorieId",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "montant",
      "value": ""
    },
    {
      "key": "billetId",
      "value": ""
    },
    {
      "key": "code",
      "value": ""
    },
    {
      "key": "secondCode",
      "value": ""
    },
    {
      "key": "evenementId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Réserver deux places",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\"clientId\": {{clientId}}, \"lignes\": [{\"categorieBilletEvenementId\": {{categorieId}}, \"quantite\": 2}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const r = pm.response.json(); pm.collectionVariables.set(\"reservationId\", r.id); pm.collectionVariables.set(\"montant\", r.montantTotal); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Aucun billet avant paiement",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/billets/reservation/{{reservationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Liste vide\", () => pm.expect(pm.response.json()).to.have.lengthOf(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Payer la réservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/paiements/reservation/{{reservationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"montant\": {{montant}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Paiement réussi\", () => pm.expect(pm.response.json().statut).to.eql(\"SUCCESS\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Récupérer deux billets",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/billets/reservation/{{reservationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const tickets = pm.response.json();",
              "pm.test(\"Deux billets distincts\", () => { pm.expect(tickets).to.have.lengthOf(2); pm.expect(tickets[0].code).not.to.eql(tickets[1].code); });",
              "if (Array.isArray(tickets) && tickets.length === 2) { pm.collectionVariables.set(\"billetId\", tickets[0].id); pm.collectionVariables.set(\"code\", tickets[0].code); pm.collectionVariables.set(\"secondCode\", tickets[1].code); pm.collectionVariables.set(\"evenementId\", tickets[0].evenementId); }"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Répéter le paiement",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/paiements/reservation/{{reservationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"montant\": {{montant}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Vérifier absence de doublons",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/billets/reservation/{{reservationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Toujours deux billets\", () => pm.expect(pm.response.json()).to.have.lengthOf(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Consulter par ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/billets/{{billetId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Vérifier sans consommer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/billets/{{code}}/verifier",
        "body": {
          "mode": "raw",
          "raw": "{\"evenementId\": {{evenementId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Toujours VALID\", () => { pm.expect(pm.response.json().statut).to.eql(\"VALID\"); pm.expect(pm.response.json().dateControle).to.eql(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Refuser un autre événement",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/billets/{{code}}/controler",
        "body": {
          "mode": "raw",
          "raw": "{\"evenementId\": 9223372036854775807}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Premier passage accepté",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/billets/{{code}}/controler",
        "body": {
          "mode": "raw",
          "raw": "{\"evenementId\": {{evenementId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"USED et date enregistrée\", () => { pm.expect(pm.response.json().statut).to.eql(\"USED\"); pm.expect(pm.response.json().dateControle).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Deuxième passage refusé",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/billets/{{code}}/controler",
        "body": {
          "mode": "raw",
          "raw": "{\"evenementId\": {{evenementId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Autre billet toujours valide",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/billets/{{secondCode}}/verifier",
        "body": {
          "mode": "raw",
          "raw": "{\"evenementId\": {{evenementId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Code inconnu",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/billets/code/UNKNOWN"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Validation du contrôle",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/billets/{{secondCode}}/controler",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
