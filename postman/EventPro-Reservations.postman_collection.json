{
  "info": {
    "name": "EventPro - Reservation (partie 2)",
    "description": "Exécuter la fixture SQL fournie, puis copier clientId, categorieId et codePromotion dans les variables. Lancer dans l'ordre. Voir RESERVATIONS.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "categorieId",
      "value": ""
    },
    {
      "key": "codePromotion",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "reference",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Réserver deux billets avec promotion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": {{clientId}},\n  \"lignes\": [{\"categorieBilletEvenementId\": {{categorieId}}, \"quantite\": 2}],\n  \"codePromotion\": \"{{codePromotion}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const r = pm.response.json(); pm.collectionVariables.set(\"reservationId\", r.id); pm.collectionVariables.set(\"reference\", r.reference); }",
              "pm.test(\"Montant 180 avec fixture fournie\", () => pm.expect(pm.response.json().montantTotal).to.eql(180));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Consulter par ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reservations/{{reservationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Consulter par référence",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reservations/reference/{{reference}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Réservations du client",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reservations/client/{{clientId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Quota cumulé dépassé (2 + 2 > 3)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": {{clientId}},\n  \"lignes\": [{\"categorieBilletEvenementId\": {{categorieId}}, \"quantite\": 2}]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Stock insuffisant (6 > 3 disponibles)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": {{clientId}},\n  \"lignes\": [{\"categorieBilletEvenementId\": {{categorieId}}, \"quantite\": 6}]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Quantité invalide",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": {{clientId}},\n  \"lignes\": [{\"categorieBilletEvenementId\": {{categorieId}}, \"quantite\": 0}]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Annuler",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/reservations/{{reservationId}}/cancel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Répéter annulation",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/reservations/{{reservationId}}/cancel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Vérifier statut CANCELLED",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reservations/{{reservationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Annulée\", () => pm.expect(pm.response.json().statut).to.eql(\"CANCELLED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Réserver de nouveau après libération",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": {{clientId}},\n  \"lignes\": [{\"categorieBilletEvenementId\": {{categorieId}}, \"quantite\": 2}],\n  \"codePromotion\": \"{{codePromotion}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const r = pm.response.json(); pm.collectionVariables.set(\"reservationId\", r.id); pm.collectionVariables.set(\"reference\", r.reference); }"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Nettoyer le second panier",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/reservations/{{reservationId}}/cancel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
